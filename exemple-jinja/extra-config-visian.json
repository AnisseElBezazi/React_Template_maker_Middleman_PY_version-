{
    "cv_name": "personal_information.full_name",
    "cv_job_title": "personal_information.job_title",
    "cv_file_prefix": "personal_information.trigram",
    "dt_boond_config": {
        "dt_boond_skills": {
            "source": [
                {
                    "source": "technical_skills",
                    "data_type": "key_values_array",
                    "display_name": "Compétences techniques:"
                },
                {
                    "source": "functional_skills",
                    "data_type": "key_values_array",
                    "display_name": "Compétences fonctionnelles:"
                }
            ],
            "join_string": "\n"
        },
        "dt_boond_diplomas": {
            "source": [
                {
                    "items": {
                        "source": [
                            {
                                "source": "name",
                                "data_type": "static"
                            },
                            {
                                "source": "dates",
                                "data_type": "static"
                            },
                            {
                                "source": "school",
                                "data_type": "static"
                            }
                        ],
                        "join_string": " - "
                    },
                    "source": "formations",
                    "data_type": "section_array",
                    "join_string": "\n"
                },
                {
                    "items": {
                        "source": [
                            {
                                "source": "name",
                                "data_type": "static"
                            },
                            {
                                "source": "dates",
                                "data_type": "static"
                            }
                        ],
                        "join_string": " - "
                    },
                    "source": "certifications",
                    "data_type": "section_array",
                    "join_string": "\n"
                }
            ],
            "join_string": "\n"
        },
        "dt_boond_references": {
            "title": {
                "source": "job_title",
                "data_type": "static"
            },
            "skills": {
                "source": "technical_environment",
                "data_type": "static"
            },
            "company": {
                "source": "company",
                "data_type": "static"
            },
            "description": {
                "source": [
                    {
                        "source": "description",
                        "data_type": "array"
                    }
                ],
                "join_string": "\n"
            }
        },
        "import_cv_job_title": "personal_information.job_title"
    },
    "frontend_cvparser_config": [
        {
            "items": [
                {
                    "data_name": "trigram",
                    "data_type": "static",
                    "display_name": "Trigramme"
                },
                {
                    "data_name": "first_name",
