# Copier ce fichier en `.env` dans le même dossier, puis renseigner la clé
# correspondant au modèle choisi dans lib/pipeline.mjs (constante MODEL).

# Modèles Claude (claude-opus-5, claude-sonnet-5...) -- console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Modèles Kimi (kimi-k3) -- platform.moonshot.ai
MOONSHOT_API_KEY=sk-...
